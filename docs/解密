<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>平行时空 · 后台推理</title>
<style>
  :root{
    --ink:#2b2622;        /* 粗描边/主文字 */
    --paper:#d8cbb3;      /* 做旧纸底 */
    --paper2:#c4b69c;
    --bg:#1e1b18;         /* 场景暗底 */
    --accent:#8a3b2e;     /* 绣湖式暗红点缀 */
    --dim:#6b6157;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{margin:0;height:100%;background:#0f0d0b;font-family:"Songti SC","STSong",serif;color:var(--ink);}
  body{display:flex;align-items:center;justify-content:center;}
  #phone{
    position:relative;width:390px;height:844px;max-height:100vh;max-width:100vw;
    background:var(--bg);overflow:hidden;
    border:3px solid var(--ink);border-radius:22px;
    box-shadow:0 0 0 6px #0a0908, 0 18px 50px rgba(0,0,0,.6);
  }
  @media (max-width:430px){
    #phone{width:100vw;height:100vh;border-radius:0;border:none;box-shadow:none;}
  }

  /* ---------- 通用做旧纹理 ---------- */
  .grain::after{
    content:"";position:absolute;inset:0;pointer-events:none;opacity:.10;
    background-image:radial-gradient(circle at 20% 30%,#000 0 1px,transparent 1px),
                     radial-gradient(circle at 70% 60%,#000 0 1px,transparent 1px),
                     radial-gradient(circle at 40% 80%,#000 0 1px,transparent 1px);
    background-size:7px 7px,11px 11px,13px 13px;mix-blend-mode:multiply;
  }

  /* ---------- 场景层 ---------- */
  .scene{position:absolute;inset:0;display:none;}
  .scene.active{display:block;}

  /* 顶部进度 & 提示 */
  #hud{
    position:absolute;top:0;left:0;right:0;z-index:30;padding:12px 14px 8px;
    background:linear-gradient(180deg,rgba(15,13,11,.92),rgba(15,13,11,0));
    color:var(--paper);font-size:13px;letter-spacing:.5px;
    display:flex;justify-content:space-between;align-items:center;pointer-events:none;
  }
  #counter{font-weight:bold;}
  #hint{
    position:absolute;left:14px;right:14px;bottom:14px;z-index:30;
    background:rgba(43,38,34,.92);color:var(--paper);border:2px solid var(--paper2);
    border-radius:10px;padding:9px 12px;font-size:13px;line-height:1.4;
    box-shadow:0 4px 16px rgba(0,0,0,.5);
  }
  #hint b{color:#e6b98a;}

  /* ---------- 后台空间 ---------- */
  #backstage{background:
      radial-gradient(120% 80% at 50% 0%,#3a332c 0%,#211d19 55%,#14110e 100%);}
  .room-line{position:absolute;background:var(--dim);opacity:.5;}
  #wall-floor{position:absolute;left:0;right:0;top:58%;height:2px;background:#4a4239;opacity:.7;}

  .item{
    position:absolute;cursor:pointer;user-select:none;
    transition:transform .18s ease, filter .18s ease;
    touch-action:manipulation;
  }
  .item .art{
    position:relative;border:3px solid var(--ink);border-radius:8px;
    background:var(--paper);display:flex;align-items:center;justify-content:center;
    box-shadow:3px 4px 0 rgba(0,0,0,.45);
    transition:box-shadow .18s ease, transform .18s ease;
  }
  .item:hover .art,.item.press .art{
    box-shadow:0 0 0 3px #e6b98a, 4px 5px 0 rgba(0,0,0,.5);
    transform:translateY(-2px);
  }
  .item .label{
    position:absolute;left:50%;bottom:-20px;transform:translateX(-50%);
    font-size:11px;color:var(--paper);opacity:.85;white-space:nowrap;letter-spacing:.5px;
    text-shadow:0 1px 2px #000;
  }
  .item .art .glyph{font-size:22px;color:var(--ink);font-family:"PingFang SC",sans-serif;}
  .item.done .art{background:#b7a98f;}
  .item.done::after{
    content:"✓";position:absolute;top:-10px;right:-10px;width:22px;height:22px;
    background:var(--accent);color:#fff;border:2px solid var(--ink);border-radius:50%;
    font-size:13px;display:flex;align-items:center;justify-content:center;
  }

  /* 各物件位置与形状 */
  #item-id{left:8%;top:12%;width:92px;height:64px;}
  #item-ticket{left:56%;top:10%;width:96px;height:60px;}
  #item-passport{left:62%;top:26%;width:58px;height:74px;}
  #item-sms{left:10%;top:38%;width:62px;height:104px;}
  #item-phone{left:66%;top:46%;width:58px;height:100px;}
  #item-mask{left:14%;top:64%;width:72px;height:72px;border-radius:50%;}
  #item-mask .art{border-radius:50%;}
  #item-glass{left:54%;top:66%;width:92px;height:92px;}

  #item-sms .art{background:#1b1815;color:#cfe3b8;}
  #item-phone .art{background:#171412;color:#e6b98a;flex-direction:column;gap:4px;}
  #item-mask .art{background:#e8ddc6;}
  #item-glass .art{background:transparent;border-style:dashed;box-shadow:none;}

  .phone-screen{font-size:9px;line-height:1.25;text-align:center;padding:4px;letter-spacing:0;}
  .phone-notify{font-size:8px;color:#9fb98a;}

  /* 碎镜拖拽 */
  #item-glass{cursor:grab;}
  #item-glass.dragging{cursor:grabbing;z-index:40;}

  /* ---------- 弹层：经历碎片 ---------- */
  #fragment{
    position:absolute;inset:0;z-index:50;display:none;
    align-items:center;justify-content:center;padding:24px;
    background:rgba(10,8,6,.82);
  }
  #fragment.show{display:flex;}
  .card{
    width:100%;background:var(--paper);border:3px solid var(--ink);border-radius:14px;
    padding:20px 18px;box-shadow:6px 8px 0 rgba(0,0,0,.5);position:relative;
  }
  .card h3{margin:0 0 4px;font-size:16px;letter-spacing:1px;}
  .card .tag{font-size:11px;color:var(--accent);letter-spacing:2px;margin-bottom:12px;}
  .card p{margin:0;font-size:14px;line-height:1.7;color:#3a332c;}
  .card .close{
    margin-top:18px;width:100%;padding:10px;border:2px solid var(--ink);border-radius:8px;
    background:var(--accent);color:#fff;font-size:14px;letter-spacing:2px;cursor:pointer;
    font-family:inherit;
  }
  .card .close:active{transform:translateY(1px);}

  /* ---------- 推理面板 ---------- */
  #deduce{background:radial-gradient(120% 80% at 50% 0%,#2b2622,#120f0c);padding:60px 20px 30px;overflow-y:auto;}
  #deduce .head{color:var(--paper);text-align:center;margin-bottom:18px;}
  #deduce .head h2{margin:0 0 6px;font-size:18px;letter-spacing:2px;}
  #deduce .head p{margin:0;font-size:12px;opacity:.8;line-height:1.5;}
  .choice{
    width:100%;text-align:left;margin-bottom:12px;padding:14px 16px;
    background:var(--paper);border:3px solid var(--ink);border-radius:12px;
    font-family:inherit;font-size:14px;color:var(--ink);cursor:pointer;
    box-shadow:4px 5px 0 rgba(0,0,0,.45);transition:transform .15s ease;
  }
  .choice:active{transform:translateY(2px);}
  .choice .sub{display:block;font-size:11px;color:var(--dim);margin-top:4px;}
  .choice.wrong{background:#c98a7e;animation:shake .3s;}
  @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}

  /* ---------- 解锁页 ---------- */
  #unlock{background:radial-gradient(120% 90% at 50% 20%,#33281f,#0d0b09);padding:60px 22px 30px;text-align:center;color:var(--paper);}
  #unlock h2{font-size:20px;letter-spacing:3px;margin:0 0 4px;color:#e6b98a;}
  #unlock .song{font-size:13px;opacity:.85;letter-spacing:2px;margin-bottom:20px;}
  .stage-anim{
    width:100%;aspect-ratio:3/4;border:3px solid var(--ink);border-radius:14px;
    background:repeating-linear-gradient(45deg,#2a231d,#2a231d 12px,#241e19 12px,#241e19 24px);
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    color:#8c7f6d;font-size:13px;letter-spacing:2px;gap:8px;margin-bottom:16px;
    box-shadow:inset 0 0 60px rgba(0,0,0,.7);
  }
  .stage-anim .spark{font-size:26px;color:#e6b98a;animation:twinkle 1.8s infinite;}
  @keyframes twinkle{0%,100%{opacity:.4}50%{opacity:1}}
  #unlock .desc{font-size:13px;line-height:1.8;opacity:.85;margin-bottom:22px;}
  #unlock .again{
    padding:11px 22px;border:2px solid var(--paper2);border-radius:9px;background:transparent;
    color:var(--paper);font-family:inherit;font-size:13px;letter-spacing:2px;cursor:pointer;
  }

  /* ---------- 开场引导 ---------- */
  #intro{
    position:absolute;inset:0;z-index:60;display:flex;flex-direction:column;
    align-items:center;justify-content:center;text-align:center;padding:36px 26px;
    background:radial-gradient(120% 90% at 50% 30%,#2e2822,#0b0908);
    color:var(--paper);transition:opacity .4s ease;
  }
  #intro.hide{opacity:0;pointer-events:none;}
  #intro .seal{
    width:70px;height:70px;border:3px solid var(--paper2);border-radius:50%;
    display:flex;align-items:center;justify-content:center;font-size:26px;color:#e6b98a;
    margin-bottom:22px;
  }
  #intro h1{font-size:21px;letter-spacing:4px;margin:0 0 14px;}
  #intro p{font-size:13.5px;line-height:1.9;opacity:.88;margin:0 0 8px;max-width:300px;}
  #intro .how{color:#e6b98a;}
  #intro button{
    margin-top:26px;padding:13px 40px;background:var(--accent);color:#fff;
    border:2px solid var(--paper2);border-radius:10px;font-family:inherit;
    font-size:15px;letter-spacing:3px;cursor:pointer;
  }
  #intro button:active{transform:translateY(2px);}

  /* 通用 */
  .shake-tip{animation:shake .3s;}
</style>
</head>
<body>
<div id="phone" class="grain">

  <!-- 开场引导 -->
  <div id="intro">
    <div class="seal">⏳</div>
    <h1>平 行 时 空</h1>
    <p>你走进一间<b>后台空间</b>，这里散落着一个人留下的东西。</p>
    <p class="how">点击、翻转、拼合这些物件，<br>读出他经历过什么。<br>集齐 <b>6 段经历</b>后，<br>推理出这里属于哪一个舞台。</p>
    <p style="opacity:.6;font-size:12px;">发光 / 高亮的物件都可以点。</p>
    <button onclick="startGame()">走 进 后 台</button>
  </div>

  <!-- HUD -->
  <div id="hud" style="display:none;">
    <span>经历碎片</span>
    <span id="counter">0 / 6</span>
  </div>
  <div id="hint" style="display:none;">先看看这里有什么。<b>点一点发亮的物件。</b></div>

  <!-- 场景一：后台空间 -->
  <div class="scene active" id="backstage">
    <div id="wall-floor"></div>

    <!-- 学生证 -->
    <div class="item" id="item-id" data-key="id">
      <div class="art"><span class="glyph">证</span></div>
      <span class="label">学生证</span>
    </div>

    <!-- 机票存根 -->
    <div class="item" id="item-ticket" data-key="ticket">
      <div class="art"><span class="glyph">票</span></div>
      <span class="label">机票存根</span>
    </div>

    <!-- 护照（组合目标） -->
    <div class="item" id="item-passport" data-key="passport">
      <div class="art"><span class="glyph">照</span></div>
      <span class="label">护照</span>
    </div>

    <!-- 短信 -->
    <div class="item" id="item-sms" data-key="sms">
      <div class="art">
        <div class="phone-screen">
          <div class="phone-notify">1 条新短信</div>
          <div style="margin-top:6px;">“你想当<br>偶像吗？”</div>
        </div>
      </div>
      <span class="label">一条短信</span>
    </div>

    <!-- 恶评手机 -->
    <div class="item" id="item-phone" data-key="phone">
      <div class="art">
        <div class="phone-screen" style="color:#c98a7e;">恶评<br>刷屏中</div>
      </div>
      <span class="label">亮着的手机</span>
    </div>

    <!-- 小丑面具 -->
    <div class="item" id="item-mask" data-key="mask">
      <div class="art"><span class="glyph">面</span></div>
      <span class="label">小丑面具</span>
    </div>

    <!-- 碎镜 -->
    <div class="item" id="item-glass" data-key="glass">
      <div class="art"><span class="glyph" style="opacity:.6;">镜</span></div>
      <span class="label">碎掉的镜子</span>
    </div>
  </div>

  <!-- 场景二：经历碎片弹层 -->
  <div id="fragment">
    <div class="card">
      <div class="tag" id="frag-tag">经历碎片</div>
      <h3 id="frag-title"></h3>
      <p id="frag-text"></p>
      <button class="close" onclick="closeFragment()">收 好</button>
    </div>
  </div>

  <!-- 场景三：推理面板 -->
  <div class="scene" id="deduce">
    <div class="head">
      <h2>这是哪一个舞台？</h2>
      <p>你已经读完了 6 段经历。<br>根据这些碎片，选出它们指向的舞台。</p>
    </div>
    <button class="choice" onclick="guess(this,false)">《Artist》
      <span class="sub">偶像练习生时期 · 从零竞争</span></button>
    <button class="choice" onclick="guess(this,false)">《无我》
      <span class="sub">ONER 出道 · 四人成团</span></button>
    <button class="choice" onclick="guess(this,true)">《平行时空》
      <span class="sub">面具、镜子与恶评 · 摔碎后重塑自我</span></button>
    <button class="choice" onclick="guess(this,false)">《过敏》
      <span class="sub">打歌舞台 · 出道后的作品</span></button>
    <div id="hint" style="position:static;margin-top:6px;text-align:center;background:none;border:none;box-shadow:none;color:#9a8f7f;">
      选错了也没关系，可以再想。
    </div>
  </div>

  <!-- 场景四：解锁页 -->
  <div class="scene" id="unlock">
    <h2>舞 台 解 锁</h2>
    <div class="song">《平行时空》 · 岳明辉</div>
    <div class="stage-anim">
      <div class="spark">✦</div>
      <div>[ 舞台造型动画占位 ]</div>
      <div style="font-size:11px;opacity:.7;">PLACEHOLDER_STAGE_ANIM</div>
    </div>
    <div class="desc">
      面具被摔碎，镜子围成的包围圈裂开一道光。<br>
      他从被凝视的商品，走回自己。
    </div>
    <button class="again" onclick="restart()">再 走 一 遍</button>
  </div>

</div>

<script>
  const TOTAL = 6;
  const found = new Set();

  const FRAGS = {
    id: {
      tag: "理工科的起点",
      title: "一张学生证",
      text: "南京航空航天大学的校徽，背面印着他的名字。那时候他本可以走一条安稳、体面、被所有人祝福的路——读书、毕业、进好公司。可这条路，他后来亲手拐了个弯。"
    },
    ticket: {
      tag: "转身",
      title: "机票与护照",
      text: "格拉斯哥的录取、飞往英国的机票存根。高薪的前景已经在手边，他却在登机口前把行李转了个方向。不是不知道这条路有多稳，是心里另一样东西更响。"
    },
    sms: {
      tag: "一个决定",
      title: "“你想当偶像吗？”",
      text: "一条再普通不过的短信，屏幕在深夜里亮起来。那时他二十六岁，在练习生的世界里已经算“大龄”。他回了什么，没人知道；但从此，他把自己重新交了出去。"
    },
    phone: {
      tag: "被凝视",
      title: "亮着的手机",
      text: "屏幕上是刷不完的评价。有人夸，有人骂，有人把他拆成一条条标签来打量。他站在聚光灯下，也站在无数双眼睛底下，一举一动都被放大、被定义。"
    },
    mask: {
      tag: "被塑造",
      title: "小丑面具",
      text: "一张印在后脑勺的面具。它笑着，但笑不是他的。当一个人被反复要求“讨人喜欢”，真实的表情会慢慢退到后面，留下一张永远合时宜的脸。"
    },
    glass: {
      tag: "重塑",
      title: "碎掉的镜子",
      text: "镜子围成一圈，像一道看不见的墙。他伸手，把它砸碎——碎片落地的声音里，那张被摆布的脸终于停下。不是逃开凝视，是穿过它，走回自己。"
    }
  };

  const HINTS = [
    "先看看这里有什么。<b>点一点发亮的物件。</b>",
    "找到了一段。<b>继续翻，还有没被读到的经历。</b>",
    "机票好像该和另一样东西放在一起——<b>试着拖动它。</b>",
    "镜子的碎片散着，<b>拖动它们拼合起来。</b>",
    "还差最后一点。<b>点亮的东西都点过了吗？</b>",
    "六段经历都读完了。<b>去推理那个舞台。</b>"
  ];

  let dragging = null, dragMoved = false;

  function startGame(){
    document.getElementById('intro').classList.add('hide');
    setTimeout(()=>{document.getElementById('intro').style.display='none';},420);
    document.getElementById('hud').style.display='flex';
    showHint(HINTS[0]);
  }

  function showHint(html){
    const h = document.getElementById('hint');
    h.style.display='block';
    h.innerHTML = html;
  }

  function updateHint(){
    const n = found.size;
    // 特殊提示：拿到机票但没护照，或反之
    if(found.has('ticket') && !found.has('passport')) { showHint("机票找到了一半。<b>再看看旁边那本护照。</b>"); return; }
    if(found.has('passport') && !found.has('ticket')) { showHint("护照在这。还有一张<b>机票存根</b>没对上。"); return; }
    if(found.has('glass') && found.has('ticket')) { /* 正常 */ }
    if(n >= TOTAL){ showHint("六段经历都读完了。<b>去推理那个舞台。</b>"); setTimeout(goDeduce, 700); return; }
    showHint(HINTS[Math.min(n, HINTS.length-1)]);
  }

  function collect(key){
    if(found.has(key)) return;
    found.add(key);
    document.querySelector('.item[data-key="'+key+'"]').classList.add('done');
    document.getElementById('counter').textContent = found.size + ' / ' + TOTAL;
    updateHint();
    // 显示经历卡片
    openFragment(key);
  }

  function openFragment(key){
    const f = FRAGS[key];
    document.getElementById('frag-tag').textContent = '经历碎片 · ' + f.tag;
    document.getElementById('frag-title').textContent = f.title;
    document.getElementById('frag-text').textContent = f.text;
    document.getElementById('fragment').classList.add('show');
  }

  function closeFragment(){
    document.getElementById('fragment').classList.remove('show');
  }

  // ---------- 交互绑定 ----------
  // 1) 学生证：点击翻转
  const idEl = document.getElementById('item-id');
  idEl.addEventListener('click', ()=>{
    if(found.has('id')) return;
    idEl.querySelector('.glyph').textContent = '南航';
    idEl.querySelector('.glyph').style.fontSize = '13px';
    idEl.querySelector('.label').textContent = '南航学生证';
    setTimeout(()=>collect('id'), 260);
  });

  // 2) 短信：点击亮屏
  const smsEl = document.getElementById('item-sms');
  smsEl.addEventListener('click', ()=>{
    if(found.has('sms')) return;
    collect('sms');
  });

  // 3) 恶评手机：点击亮屏
  const phoneEl = document.getElementById('item-phone');
  phoneEl.addEventListener('click', ()=>{
    if(found.has('phone')) return;
    phoneEl.querySelector('.phone-screen').innerHTML = '被人群<br>盯着的屏幕';
    phoneEl.querySelector('.phone-screen').style.color = '#e6b98a';
    setTimeout(()=>collect('phone'), 260);
  });

  // 4) 面具：点击翻面
  const maskEl = document.getElementById('item-mask');
  maskEl.addEventListener('click', ()=>{
    if(found.has('mask')) return;
    maskEl.querySelector('.glyph').textContent = '笑';
    maskEl.querySelector('.art').style.background = '#c98a7e';
    setTimeout(()=>collect('mask'), 260);
  });

  // 5) 机票 ↔ 护照：拖拽组合
  const ticketEl = document.getElementById('item-ticket');
  const passportEl = document.getElementById('item-passport');
  let ticketDragging = false, ticketOffset = {x:0,y:0};

  ticketEl.addEventListener('pointerdown', (e)=>{
    if(found.has('ticket')) return;
    ticketDragging = true; dragMoved = false;
    ticketEl.setPointerCapture(e.pointerId);
    const r = ticketEl.getBoundingClientRect();
    ticketOffset.x = e.clientX - r.left;
    ticketOffset.y = e.clientY - r.top;
    ticketEl.style.zIndex = 45;
    ticketEl.style.cursor = 'grabbing';
  });
  ticketEl.addEventListener('pointermove', (e)=>{
    if(!ticketDragging || found.has('ticket')) return;
    dragMoved = true;
    const phone = document.getElementById('phone').getBoundingClientRect();
    const x = e.clientX - phone.left - ticketOffset.x;
    const y = e.clientY - phone.top - ticketOffset.y;
    ticketEl.style.left = Math.max(0, Math.min(phone.width-96, x)) + 'px';
    ticketEl.style.top  = Math.max(0, Math.min(phone.height-60, y)) + 'px';
    // 碰撞检测
    if(overlaps(ticketEl, passportEl)) onTicketPassport();
  });
  ticketEl.addEventListener('pointerup', (e)=>{
    if(ticketDragging && !found.has('ticket')) {
      // 若没成功组合，回弹
      ticketEl.style.left = ''; ticketEl.style.top = '';
    }
    ticketDragging = false;
    ticketEl.style.zIndex = '';
    ticketEl.style.cursor = '';
  });

  function onTicketPassport(){
    if(found.has('ticket')) return;
    ticketEl.style.left = ''; ticketEl.style.top = '';
    ticketEl.style.pointerEvents = 'none';
    passportEl.querySelector('.glyph').textContent = '✈';
    passportEl.querySelector('.label').textContent = '护照 + 机票';
    setTimeout(()=>collect('ticket'), 200);
  }

  // 6) 碎镜：拖拽拼合（简化：拖动后靠近中心即拼合）
  const glassEl = document.getElementById('item-glass');
  let glassDragging = false, glassOffset = {x:0,y:0};
  glassEl.addEventListener('pointerdown', (e)=>{
    if(found.has('glass')) return;
    glassDragging = true;
    glassEl.setPointerCapture(e.pointerId);
    const r = glassEl.getBoundingClientRect();
    glassOffset.x = e.clientX - r.left;
    glassOffset.y = e.clientY - r.top;
    glassEl.style.zIndex = 45;
    glassEl.style.cursor = 'grabbing';
  });
  glassEl.addEventListener('pointermove', (e)=>{
    if(!glassDragging || found.has('glass')) return;
    const phone = document.getElementById('phone').getBoundingClientRect();
    const x = e.clientX - phone.left - glassOffset.x;
    const y = e.clientY - phone.top - glassOffset.y;
    glassEl.style.left = x + 'px';
    glassEl.style.top  = y + 'px';
    // 靠近右下方“拼合区”即触发
    if(x > phone.width*0.45 && y > phone.height*0.45 && Math.abs(x - phone.width*0.58) < 70){
      onGlassDone();
    }
  });
  glassEl.addEventListener('pointerup', ()=>{
    if(!glassDragging || found.has('glass')) return;
    glassEl.style.left = ''; glassEl.style.top = '';
    glassDragging = false;
    glassEl.style.zIndex = ''; glassEl.style.cursor = '';
  });
  function onGlassDone(){
    if(found.has('glass')) return;
    glassDragging = false;
    glassEl.style.left = ''; glassEl.style.top = '';
    glassEl.querySelector('.art').style.borderStyle = 'solid';
    glassEl.querySelector('.glyph').textContent = '镜';
    glassEl.querySelector('.glyph').style.opacity = '1';
    glassEl.querySelector('.label').textContent = '拼合的镜子';
    setTimeout(()=>collect('glass'), 200);
  }

  function overlaps(a,b){
    const ra=a.getBoundingClientRect(), rb=b.getBoundingClientRect();
    return !(ra.right<rb.left || ra.left>rb.right || ra.bottom<rb.top || ra.top>rb.bottom);
  }

  // 推理
  function goDeduce(){
    document.getElementById('backstage').classList.remove('active');
    document.getElementById('hud').style.display='none';
    document.getElementById('hint').style.display='none';
    document.getElementById('deduce').classList.add('active');
    window.scrollTo(0,0);
  }

  function guess(btn, correct){
    if(correct){
      document.getElementById('deduce').classList.remove('active');
      document.getElementById('unlock').classList.add('active');
    } else {
      btn.classList.add('wrong');
      setTimeout(()=>btn.classList.remove('wrong'), 400);
    }
  }

  function restart(){
    location.reload();
  }
</script>
</body>
